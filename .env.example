# ==============================================================================
# MEOWSHADOW LAB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to .env (cp .env.example .env) before starting services.
# Variable details and documentation: docs/6_DEVELOPMENT_GUIDE_AND_ENV.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL PROJECT CONFIGURATION (MONOREPO)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=meowshadow-lab
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=meowuser
POSTGRES_PASSWORD=meowpassword
POSTGRES_DB=meowshadow_db
POSTGRES_PORT=5432
# Internal connection string between containers in Docker Network
DATABASE_URL=postgres://meowuser:meowpassword@postgres-db:5432/meowshadow_db?sslmode=disable
# Host connection string for local debugging outside Docker
DATABASE_URL_HOST=postgres://meowuser:meowpassword@localhost:5432/meowshadow_db?sslmode=disable

# ------------------------------------------------------------------------------
# 3. REDIS 7 BROKER & CACHE
# ------------------------------------------------------------------------------
REDIS_HOST=redis-broker
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ADDR=redis-broker:6379
REDIS_ADDR_HOST=localhost:6379

# ------------------------------------------------------------------------------
# 4. GOLANG CORE API GATEWAY & STREAMING SERVER
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
JWT_SECRET=meowshadow_super_secret_jwt_key_2026_change_in_production_min_32_chars!
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. DOCKER SHARED STORAGE VOLUME (AUDIO & SUBTITLES)
# ------------------------------------------------------------------------------
# Internal storage directory inside Docker container
STORAGE_DIR=/app/storage
# Host directory path for local debugging (optional)
STORAGE_DIR_HOST=./storage
MAX_AUDIO_UPLOAD_MB=50

# ------------------------------------------------------------------------------
# 6. PYTHON WORKER: SCRIPT & LLM SERVICE (Qwen 2.5)
# ------------------------------------------------------------------------------
SCRIPT_LLM_PORT=8001
# Ollama host connection from inside Docker container
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:14b
LLM_FALLBACK_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 7. PYTHON WORKER: MULTI-TTS SYNTHESIS SERVICE
# ------------------------------------------------------------------------------
TTS_ENGINE_PORT=8002
DEFAULT_TTS_ENGINE=edge-tts
TTS_CACHE_DIR=/app/storage/cache
TTS_REQUEST_TIMEOUT_SEC=60
MAX_PARALLEL_TTS_REQUESTS=10

# ------------------------------------------------------------------------------
# 8. PYTHON WORKER: AUDIO PROCESSOR & PACING SERVICE
# ------------------------------------------------------------------------------
AUDIO_PROCESSOR_PORT=8003
DEFAULT_TARGET_LUFS=-16.0
DEFAULT_SILENCE_BETWEEN_SENTENCES_SEC=0.5
DEFAULT_SILENCE_AFTER_VI_SEC=1.5
DEFAULT_SILENCE_AFTER_TARGET_SEC=3.5

# ------------------------------------------------------------------------------
# 9. FRONTEND WEB STUDIO (NEXT.JS 15)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PORT=3000

# ------------------------------------------------------------------------------
# 10. MOBILE CLIENT (EXPO / REACT NATIVE)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 11. PUSH NOTIFICATIONS (OPTIONAL FOR MOBILE)
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
